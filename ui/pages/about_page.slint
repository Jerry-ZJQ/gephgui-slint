import { Colors } from "../theme/colors.slint";
import { ServerSection, ServerButton, ServerDivider } from "../controls/server_panel.slint";
import { CountryFlags } from "../theme/resources.slint";
import { Metrics } from "../theme/metrics.slint";
import { Typography } from "../theme/typography.slint";

import { Icons } from "../theme/resources.slint";
import { NewsCard } from "../controls/news_card.slint";
import { IconButton } from "../controls/icon_button.slint";
import { L10n } from "../l10n.slint";
import { About } from "../ui_state.slint";
import { NewsItem } from "../controls/news_item.slint";

export component AboutPage inherits Rectangle {

    callback github_clicked();
    callback forum_clicked();
    callback official_clicked();

    background: Colors.background;

    VerticalLayout {

        padding: Metrics.padding_large;
        spacing: Metrics.spacing_medium;

        NewsCard {
            vertical-stretch: 1;

            if About.update-available : NewsItem {
                news_title: L10n.text.update-available;
                news_body: "Version " + About.latest-version + L10n.text.go-for-update;
                clickable: true;
                url: About.release-url;
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }

        HorizontalLayout {
            spacing: Metrics.spacing_large;

            IconButton {
                btn_icon: Icons.github;
                icon_scale: 0.8;
                clicked => {
                    root.github_clicked();
                }
            }
            IconButton {
                btn_icon: Icons.geph_forum;
                icon_scale: 0.7;
                clicked => {
                    root.forum_clicked();
                }
            }
            IconButton {
                btn_icon: Icons.gephlogo;
                icon_scale: 0.7;
                clicked => {
                    root.official_clicked();
                }
            }
        }

        version := Text {
            text: "Version " + About.app-version;
            font-size: Typography.font_caption;
            color: Colors.text_main;
            wrap: word-wrap;
            vertical-alignment: bottom;
            horizontal-alignment: center;
        }

        about_slint_app := Text {
            text: L10n.text.app-intro;
            font-size: Typography.font_caption;
            color: Colors.text_main;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}