import { Colors } from "../theme/colors.slint";
import { SettingSwitch, SettingComboBox, SettingSpinBox, SettingSection } from "../controls/setting_widgets.slint";
import { Metrics } from "../theme/metrics.slint";
import { ScrollView, Switch } from "std-widgets.slint";

import { TunnelSettings, ProxySettings, SettingActions, AccountStatus, LoginState, UserPrefs } from "../ui_state.slint";
import { L10n } from "../l10n.slint";

export component SettingsPage inherits Rectangle {

    private property <bool> proxy_enabled: ProxySettings.enabled;

    in property <bool> show_settings: AccountStatus.login_status != LoggedOut ? true : false;
    in property <bool> plus_features: AccountStatus.account_level == "Plus" ? true : false;

    callback setting_changed(action: SettingActions, value: int);

    callback language_selected(value: string);
    callback quit_on_close_toggled(value: bool);
    callback disconnect_on_quit_toggled(value: bool);

    background: Colors.background;

    ScrollView {

        width: parent.width;
        height: parent.height;

        VerticalLayout {
            
            padding: Metrics.padding_large;
            spacing: Metrics.spacing_large;

            SettingSection {
                setting_type: L10n.text.general;

                SettingComboBox {
                    setting_title: L10n.text.language;
                    helptext: L10n.text.language-help;
                    // maintain language expansion in Rust l10n.rs
                    models: L10n.available_languages;
                    selected_value: L10n.selected_label;
                    combo_box_selected(value) => {
                        root.language_selected(value);
                    }
                }
                
                SettingSwitch {
                    switch_enabled: true;
                    setting_title: L10n.text.quit-on-close;
                    helptext: L10n.text.quit-on-close-help;
                    toggle_state <=> UserPrefs.quit_on_close;
                    switch_toggled(checked) => {
                        root.quit_on_close_toggled(checked);
                    }
                }

                SettingSwitch {
                    switch_enabled: true;
                    setting_title: L10n.text.disconnect-on-quit;
                    helptext: L10n.text.disconnect-on-quit-help;
                    toggle_state <=> UserPrefs.disconnect_on_quit;
                    switch_toggled(checked) => {
                        root.disconnect_on_quit_toggled(checked);
                    }
                }
            }

            if show_settings : SettingSection {
                setting_type: L10n.text.connection;

                SettingSwitch {
                    switch_enabled: true;
                    setting_title: L10n.text.allow-direct;
                    helptext: L10n.text.allow-direct-help;
                    toggle_state <=> TunnelSettings.allow_direct;

                    switch_toggled => {
                        // debug("[Sling Settings]: Allow Direct toggled");
                        root.setting_changed(SettingActions.AllowDirect, 0);
                    }
                }
            }

            if show_settings : SettingSection {
                setting_type: L10n.text.features;

                SettingSwitch {
                    // Disable switch for Free Users
                    switch_enabled: plus_features;
                    setting_title: plus_features
                        ? L10n.text.ads-filter
                        : L10n.text.ads-filter + L10n.text.plus-only;
                    helptext: L10n.text.ads-filter-help;
                    toggle_state <=> TunnelSettings.ads_filter;

                    switch_toggled => {
                        // debug("[Sling Settings]: Ads Filter toggled");
                        root.setting_changed(SettingActions.AdsFilter, 0);
                    }
                }

                SettingSwitch {
                    // Disable switch for Free Users
                    switch_enabled: plus_features;
                    setting_title: plus_features
                        ? L10n.text.adult-filter
                        : L10n.text.adult-filter + L10n.text.plus-only;
                    helptext: L10n.text.adult-filter-help;
                    toggle_state <=> TunnelSettings.adult_filter;

                    switch_toggled => {
                        // debug("[Sling Settings]: Adult Filter toggled");
                        root.setting_changed(SettingActions.AdultFilter, 0);
                    }
                }
            }

            if show_settings : SettingSection {
                setting_type: L10n.text.split-tunneling;

                SettingSwitch {
                    switch_enabled: true;
                    setting_title: L10n.text.allow-lan;
                    helptext: L10n.text.allow-lan-help;
                    toggle_state <=> TunnelSettings.bypass_lan;

                    switch_toggled => {
                        // debug("[Sling Settings]: Bypass Lan toggled");
                        root.setting_changed(SettingActions.BypassLan, 0);
                    }
                }

                SettingSwitch {
                    switch_enabled: true;
                    setting_title: L10n.text.bypass-china;
                    helptext: L10n.text.bypass-china-help;
                    toggle_state <=> TunnelSettings.bypass_china;

                    switch_toggled => {
                        // debug("[Sling Settings]: Bypass China toggled");
                        root.setting_changed(SettingActions.BypassChina, 0);
                    }
                }
            }

            if show_settings : SettingSection {
                setting_type: L10n.text.networking;

                SettingSwitch {
                    switch_enabled: true;
                    setting_title: L10n.text.vpn-mode;
                    helptext: L10n.text.vpn-mode-help;
                    toggle_state <=> TunnelSettings.global_vpn;

                    switch_toggled => {
                        // debug("[Sling Settings]: Global VPN toggled");
                        root.setting_changed(SettingActions.GlobalVPN, 0);
                    }
                }

                SettingSwitch {
                    switch_enabled: true;
                    setting_title: L10n.text.local-proxy;
                    helptext: L10n.text.local-proxy-help;
                    toggle_state <=> ProxySettings.enabled;

                    switch_toggled => {
                        // debug("[Sling Settings]: Local Proxy toggled");
                        root.setting_changed(SettingActions.LocalProxy, 0);
                    }
                }

                // Only show proxy_setting items when local_proxy is on/true
                if root.proxy_enabled : SettingSwitch {
                    switch_enabled: root.proxy_enabled;
                    setting_title: L10n.text.auto-config;
                    helptext: L10n.text.auto-config-help;
                    toggle_state <=> ProxySettings.auto_config;

                    switch_toggled => {
                        // debug("[Sling Settings]: Auto Config toggled");
                        root.setting_changed(SettingActions.AutoConfig, 0);
                    }
                }

                if root.proxy_enabled : SettingSwitch {
                    switch_enabled: root.proxy_enabled;
                    setting_title: L10n.text.listen-all;
                    helptext: L10n.text.listen-all-help;
                    toggle_state <=> ProxySettings.listening_all;

                    switch_toggled => {
                        // debug("[Sling Settings]: Listen All toggled");
                        root.setting_changed(SettingActions.ListenAll, 0);
                    }
                }

                if root.proxy_enabled : SettingSpinBox {
                    spinbox_enabled: root.proxy_enabled;
                    setting_title: L10n.text.socks5-port;
                    helptext: L10n.text.socks5-port-help;
                    max_number: 65535;
                    port_value <=> ProxySettings.socks5_port;

                    apply_value(target_value) => {
                        root.setting_changed(SettingActions.Sock5Port, target_value);
                    }
                }

                if root.proxy_enabled : SettingSpinBox {
                    spinbox_enabled: root.proxy_enabled;
                    setting_title: L10n.text.http-port;
                    helptext: L10n.text.http-port-help;
                    max_number: 65535;
                    port_value <=> ProxySettings.http_port;

                    apply_value(target_value) => {
                        root.setting_changed(SettingActions.HttpPort, target_value);
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }
    }
}