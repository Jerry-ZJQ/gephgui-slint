export global Typography {
    // Typography
    out property <length> font_title: 18px;
    out property <length> font_section: 16px;
    out property <length> font_body: 14px;
    out property <length> font_sub_body: 12px;
    out property <length> font_caption: 10px;

    out property <int> weight_title: 600;
}