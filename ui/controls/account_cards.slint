import { StdButton } from "std_button.slint";
import { Typography } from "../theme/typography.slint";
import { Colors } from "../theme/colors.slint";
import { Metrics } from "../theme/metrics.slint";
import { SecretInput } from "secret_input.slint";
import { AnimationBar } from "animation_bar.slint";
import { VerticalLineDivider } from "divider.slint";
import { GridBox } from "std-widgets.slint";
import { AccountStatus } from "../ui_state.slint";
import { L10n } from "../l10n.slint";
import { IconButton} from "icon_button.slint";
import { Icons } from "../theme/resources.slint";

export component LogInCard inherits Rectangle {

    in property <string> login_helptext: L10n.text.login-help;
    in property <string> reg_helptext: L10n.text.register-help;
    in property <color> helptext_color: Colors.text_main;

    callback login_clicked(string);
    callback register_clicked();

    VerticalLayout {

        spacing: Metrics.spacing_small;

        Text {
            text: L10n.text.login;
            font-size: Typography.font_section;
            font-weight: Typography.weight_title;
            color: Colors.text_main;
        }

        Rectangle {

            border-radius: Metrics.radius_card;
            border-color: Colors.divider;
            border-width: Metrics.outline_slim;
            background: Colors.card;

            VerticalLayout {
                
                padding: Metrics.padding_large;
                spacing: Metrics.spacing_small;

                secret_input := SecretInput {
                    enter_pressed(secret) => {
                        root.login_clicked(secret);
                    }
                }

                Text {
                    text: login_helptext;
                    font-size: Typography.font_body;
                    color: helptext_color;
                    wrap: word-wrap;
                }

                login_button := StdButton {
                    btn_text: L10n.text.login;
                    clicked() => {
                        root.login_clicked(secret_input.secret);
                    }
                }

                Text {
                    text: reg_helptext;
                    font-size: Typography.font_body;
                    color: Colors.text_main;
                    wrap: word-wrap;
                }

                register_button := StdButton {
                    btn_text: L10n.text.register;
                    hollowed: true;
                    // disable button since account registration is in development
                    click_enabled: false;
                    btn_color: Colors.status_dot_gray;

                    clicked => {
                        root.register_clicked();
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}

export component AccountInfoCard inherits Rectangle {

    in property <string> secret: AccountStatus.secret;
    in property <string> account_level: AccountStatus.account_level;
    in property <string> plus_expire_date: AccountStatus.expire_date;
    in property <string> invite_code: AccountStatus.invite_code;
    private property <bool> secret_reveal: false;
    private property <bool> cd_secret: false;
    private property <bool> cd_inv_code: false;

    private property <int> delete_click_countdown: 10;
    private property <bool> delete_click_cooldown: false;
    private property <bool> delete_confirm: false;
    private property <int> delete_unlock_countdown: 10;

    callback manage_account_clicked();
    callback logout_clicked();
    callback delete_account_clicked();

    callback copy_secret_clicked();
    callback copy_inv_code_clicked();
    
    VerticalLayout {

        spacing: Metrics.spacing_small;

        Text {
            text: L10n.text.account-info;
            font-size: Typography.font_section;
            font-weight: Typography.weight_title;
            color: Colors.text_main;
        }

        Rectangle {

            border-radius: Metrics.radius_card;
            border-color: Colors.divider;
            border-width: Metrics.outline_slim;
            background: Colors.card;

            VerticalLayout {
                
                padding: Metrics.padding_large;
                spacing: Metrics.spacing_medium;

                Text {
                    text: L10n.text.account-secret;
                    font-size: Typography.font_body;
                    font-weight: Typography.weight_title;
                    color: Colors.text_main;
                }

                HorizontalLayout {

                    spacing: Metrics.spacing_medium;

                    Text {
                        text: secret_reveal ? secret : AccountStatus.secret_mask;
                        font-size: Typography.font_body;
                        color: Colors.text_main;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    IconButton {
                        height: Typography.font_body;
                        width: self.height;
                        hollowed: false;
                        btn_icon: secret_reveal ? Icons.hide : Icons.show;
                        btn_color: transparent;
                        clicked => {
                            root.secret_reveal = !root.secret_reveal; 
                        }
                    }

                    copy-secret := IconButton {
                        height: Typography.font_body;
                        width: self.height;
                        hollowed: false;
                        btn_icon: cd_secret ? Icons.check : Icons.copy;
                        btn_color: transparent;
                        clicked => {
                            root.copy_secret_clicked();
                            root.cd_secret = true;
                            self.click_enabled = false;        
                        }

                        Timer {
                            interval: 2000ms;
                            running: root.cd_secret;
                            triggered => {
                                root.cd_secret = false;
                                copy-secret.click_enabled = true;
                            }
                        }
                    }
                }

                VerticalLineDivider {}

                GridLayout {

                    spacing: Metrics.spacing_medium;

                    Row {
                        Text {
                            text: L10n.text.account-level;
                            font-size: Typography.font_body;
                            font-weight: Typography.weight_title;
                            color: Colors.text_main;
                        }
                        Text {
                            text: account_level;
                            font-size: Typography.font_body;
                            color: Colors.text_main;
                        }
                    }

                    if account_level == "Plus" : Row {
                        Text {
                            text: L10n.text.plus-expire;
                            font-size: Typography.font_body;
                            font-weight: Typography.weight_title;
                            color: Colors.text_main;
                        }
                        Text {
                            text: plus_expire_date;
                            font-size: Typography.font_body;
                            color: Colors.text_main;
                        }
                    }

                    Row {
                        Text {
                            text: L10n.text.invite-code;
                            font-size: Typography.font_body;
                            font-weight: Typography.weight_title;
                            color: Colors.text_main;
                        }
                        Text {
                            text: invite_code;
                            font-size: Typography.font_body;
                            color: Colors.text_main;
                            overflow: elide;
                        }

                        copy-inv-code := IconButton {
                            height: Typography.font_body;
                            width: self.height;
                            hollowed: false;
                            btn_icon: cd_inv_code ? Icons.check : Icons.copy;
                            btn_color: transparent;
                            clicked => {
                                root.copy_inv_code_clicked();
                                root.cd_inv_code = true;
                                self.click_enabled = false;
                            }

                            Timer {
                                interval: 2000ms;
                                running: root.cd_inv_code;
                                triggered => {
                                    root.cd_inv_code = false;
                                    copy-inv-code.click_enabled = true;
                                }
                            }
                        }
                    }
                }

                VerticalLineDivider {}

                Rectangle {
                    vertical-stretch: 1;
                }

                StdButton {
                    btn_text: L10n.text.manage-account;
                    clicked => {
                        root.manage_account_clicked();
                    }
                }

                StdButton {
                    btn_text: L10n.text.logout;
                    hollowed: true;
                    clicked => {
                        root.logout_clicked();
                    }
                }

                VerticalLineDivider {}

                if !root.delete_confirm : delete-btn := StdButton {
                    btn_text: L10n.text.delete-account-head + root.delete_click_countdown + L10n.text.delete-account-tail;
                    hollowed: true;
                    
                    // disable delete_account button since function is not ready
                    click_enabled: false;
                    btn_color: Colors.status_dot_gray;

                    clicked => {
                        if root.delete_click_countdown < 2 {
                            root.delete_click_cooldown = false;
                            root.delete_confirm = true;
                        }
                        else {
                            root.delete_click_countdown -= 1;
                            root.delete_click_cooldown = true;
                            delete_timer.restart();
                        }
                    }

                    // restore delete_click_countdown to 10 if no continuous click in 0.5 second
                    delete_timer := Timer {
                        interval: 500ms;
                        running: root.delete_click_cooldown;
                        triggered => {
                            if root.delete_click_countdown > 0 {
                                root.delete_click_countdown = 10;
                                root.delete_click_cooldown = false;
                            }
                        }
                    }
                }

                // Popup DialogBox for delete final confirmation
                // With 10s lockdown of button click for final consideration
                if root.delete_confirm : VerticalLayout {
                    spacing: Metrics.spacing_medium;

                    Text {
                        text: L10n.text.delete-account + L10n.text.delete-lockdown + root.delete_unlock_countdown;
                        color: Colors.status_dot_red;
                        font-size: Typography.font_body;
                        font-weight: Typography.weight_title;
                        wrap: word-wrap;
                    }
                    Text {
                        text: L10n.text.delete-warning;
                        color: Colors.status_dot_red;
                        font-size: Typography.font_sub_body;
                        font-weight: Typography.weight_title;
                        wrap: word-wrap;
                    }
                    
                    StdButton {
                        btn_text: L10n.text.confirm_delete;
                        btn_color: root.delete_unlock_countdown < 1 ? Colors.status_dot_red : Colors.status_dot_gray;
                        hollowed: root.delete_unlock_countdown > 0;
                        click_enabled: root.delete_unlock_countdown < 1;
                        clicked => {
                            root.delete_account_clicked();
                        }
                    }
                    StdButton {
                        btn_text: L10n.text.cancel_delete;
                        btn_color: root.delete_unlock_countdown < 1 ? Colors.std_button : Colors.status_dot_gray;
                        hollowed: true;
                        click_enabled: root.delete_unlock_countdown < 1;
                        clicked => {
                            root.delete_confirm = false;
                            root.delete_click_countdown = 10;
                            root.delete_unlock_countdown = 10;
                        }
                    }

                    Timer {
                        interval: 1000ms;
                        running: root.delete_confirm && root.delete_unlock_countdown > 0;
                        triggered => {
                            root.delete_unlock_countdown -= 1;
                        }
                    }
                }
            }
        }
    }
}

export component AccountRegCard inherits Rectangle {

    callback login_clicked(secret: string);

    VerticalLayout {
        spacing: Metrics.spacing_small;

        Text {
            text: L10n.text.registration;
            font-size: Typography.font_section;
            font-weight: Typography.weight_title;
            color: Colors.text_main;
        }

        Rectangle {

            border-radius: Metrics.radius_card;
            border-color: Colors.divider;
            border-width: Metrics.outline_slim;
            background: Colors.card;

            VerticalLayout {
                padding: Metrics.padding_large;
                spacing: Metrics.spacing_small;
            }
        }
    }
}