import { Colors } from "../theme/colors.slint";
import { Metrics } from "../theme/metrics.slint";
import { VerticalBox, ProgressIndicator } from "std-widgets.slint";
import { StdButton } from "std_button.slint";
import { Icons } from "../theme/resources.slint";
import { Typography } from "../theme/typography.slint";
import { VerticalLineDivider } from "divider.slint";

import { AccountStatus } from "../ui_state.slint";
import { L10n } from "../l10n.slint";

export component PlusUsageCard inherits Rectangle {

    private property <image> level_icon: Icons.plus_icon;
    in property <string> plus_title: AccountStatus.account_level;

    callback extend_clicked();

    background: Colors.card;
    border-color: Colors.divider;
    border-radius: Metrics.radius_card;
    border-width: Metrics.outline_slim;

    VerticalLayout {

        padding: Metrics.padding_large;
        spacing: Metrics.spacing_medium;

        Rectangle {

            HorizontalLayout {

                VerticalLayout {

                    spacing: Metrics.spacing_small;

                    HorizontalLayout {
                        
                        spacing: Metrics.spacing_medium;

                        Image {
                            source: level_icon;
                            height: 24px;
                            width: 24px;
                            y: ( parent.height - self.height ) / 2;
                        }

                        Text {
                            text: plus_title;
                            font-size: Typography.font_section;
                            font-weight: Typography.weight_title;
                            color: Colors.text_main;
                            horizontal-alignment: left;
                        }
                    }

                    HorizontalLayout {

                        spacing: Metrics.spacing_medium;
                        
                        Image {
                            source: Icons.calendar;
                            height: 24px;
                            width: 24px;
                            y: ( parent.height - self.height ) / 2;
                        }

                        VerticalLayout {

                            Text {
                                text: L10n.text.expire + AccountStatus.expire_date;
                                font-size: Typography.font_body;
                                color: Colors.text_main;
                                wrap: word-wrap;
                            }

                            Text {
                                text: L10n.text.days-remain + AccountStatus.remaining_days;
                                font-size: Typography.font_body;
                                color: Colors.text_main;
                                wrap: word-wrap;
                            }
                        }

                        StdButton {
                            btn_text: L10n.text.extend;
                            height: Metrics.server_button_height;
                            y: (parent.height - self.height ) / 2;
                            width: self.preferred-width + Metrics.radius_button * 2;
                            clicked => {
                                root.extend_clicked();
                            }
                        }
                    }
                }
            }
        }

        VerticalLineDivider {}

        Rectangle {
            
            HorizontalLayout {

                spacing: Metrics.spacing_medium;

                Image {
                    source: Icons.data_usage;
                    height: 24px;
                    width: 24px;
                    y: ( parent.height - self.height ) / 2;
                }

                Rectangle {

                    VerticalLayout {

                        spacing: Metrics.spacing_tiny;

                        Text {
                            text:
                                AccountStatus.remaining_usage == "Unlimited"
                                ? L10n.text.unlimited
                                : AccountStatus.remaining_usage;
                            font-size: Typography.font_body;
                            color: Colors.text_main;
                        }

                        ProgressIndicator {
                            height: 8px;
                            progress: {
                                AccountStatus.remaining_usage == "Unlimited"
                                ? 100%
                                : AccountStatus.remaining_percentage;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component FreeUsageCard inherits Rectangle {

    private property <image> free_icon: Icons.free_icon;
    in property <string> free_title: AccountStatus.account_level;
    in property <string> free_note: L10n.text.free-note;

    callback upgrade_clicked();

    background: Colors.card;
    border-color: Colors.divider;
    border-radius: Metrics.radius_card;
    border-width: Metrics.outline_slim;

    VerticalLayout {

        padding: Metrics.padding_large;
        spacing: Metrics.spacing_medium;

        Rectangle {

            HorizontalLayout {

                spacing: Metrics.spacing_medium;

                Image {
                    source: free_icon;
                    height: 24px;
                    width: 24px;
                    y: ( parent.height - self.height ) / 2;
                }

                Text {
                    text: free_title;
                    font-size: Typography.font_section;
                    font-weight: Typography.weight_title;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }

                StdButton {
                    btn_text: L10n.text.upgrade;
                    y: (parent.height - self.height ) / 2;
                    width: self.preferred-width + Metrics.radius_button * 2;
                    clicked => {
                        root.upgrade_clicked();
                    }
                }
            }
        }

        line_divider := Rectangle {
            height: 1px;
            background: Colors.divider;
            vertical-stretch: 0;
        }

        Text {
            text: free_note;
            color: Colors.text_main;
            font-size: Typography.font_body;
            wrap: word-wrap;
        }
    }
}