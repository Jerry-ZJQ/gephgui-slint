import { Metrics } from "../theme/metrics.slint";
import { Colors } from "../theme/colors.slint";
import { StdButton } from "std_button.slint";

import { ConnInfo, AccountStatus, LoginState, ConnectionState } from "../ui_state.slint";
import { L10n } from "../l10n.slint";

export component PrimaryButton inherits StdButton {

    btn_color: Colors.pri_button;
    height: Metrics.pri_button_height;
    btn_text: 
        ConnInfo.conn_state == ConnectionState.Disconnected ? L10n.text.connect :
        ConnInfo.conn_state == ConnectionState.Connecting ? L10n.text.cancel :
        L10n.text.disconnect;
}