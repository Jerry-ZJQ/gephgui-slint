import { Colors } from "../theme/colors.slint";
import { About } from "../ui_state.slint";
import { Metrics } from "../theme/metrics.slint";

export component NavButton inherits Rectangle {

    width: 48px;
    height: 48px;

    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <image> icon;
    in property <bool> show_notifier: false;

    callback clicked();

    background:
        !enabled
            ? #D8D6CE
            : selected
                ? Colors.background
                : Colors.sidebar;

    TouchArea {

        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }

    Image {

        source: root.icon;

        width: 28px;
        height: 28px;

        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // An overlay to show the notification mark 
    popup_overlay := Rectangle {
        
        visible: show_notifier;

        width: parent.width;
        height: parent.height;

        background: transparent;

        Rectangle {
            height: 8px;
            width: 8px;
            background: Colors.status_dot_red;
            border-radius: self.height / 2;
            x: 33px;
            y: 7px;
        }
    }
}